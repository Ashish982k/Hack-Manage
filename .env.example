# ==============================================================================
# HACK-MANAGE MONOREPO ROOT ENVIRONMENT REFERENCE (.env.example)
# ==============================================================================
# Hack-Manage consists of two independent packages:
#   1. backend/   -> Hono + Drizzle ORM + Turso (Runs on port 5000)
#   2. frontend/  -> Next.js 16 + Tailwind CSS v4 + Better Auth (Runs on port 3000)
#
# DO NOT place environment variables solely in the root directory.
# Copy the respective .env.example files inside `backend/` and `frontend/`:
#
#   cd backend  && cp .env.example .env
#   cd ../frontend && cp .env.example .env
#
# Below is a consolidated master checklist of all environment variables.
# ==============================================================================

# ==============================================================================
# BACKEND (backend/.env)
# ==============================================================================
# PORT=5000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000
# BETTER_AUTH_SECRET=your_32_character_random_auth_secret_here
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_database_auth_token
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_FOLDER=hackathon-headers
# EMAIL_USER=your_email@gmail.com
# EMAIL_APP_PASS=your_16_character_app_password
# APP_TIMEZONE=Asia/Kolkata

# ==============================================================================
# FRONTEND (frontend/.env)
# ==============================================================================
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:5000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
