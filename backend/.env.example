# ==============================================================================
# HACK-MANAGE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` in the backend directory:
#   cp .env.example .env
#
# Replace the placeholder values below with your actual credentials.
# NOTE: Never commit the real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. FRONTEND URL & CORS
# ------------------------------------------------------------------------------
# The origin where the frontend is hosted.
# In local development: http://localhost:3000
# In production (e.g., Render backend pointing to Vercel): https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# A secure 32+ character random secret used to sign session cookies and tokens.
# Generate one using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_auth_secret_here

# In production (e.g. on Render), set BETTER_AUTH_URL to your Vercel frontend URL.
# Better Auth requests are proxied via Next.js rewrites, so cookies are scoped to frontend origin.
# Local dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Google Cloud Console -> Credentials -> OAuth Client ID)
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
# (Production: https://<your-frontend>.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Credentials (GitHub Developer Settings -> OAuth Apps)
# Authorized Callback URL: http://localhost:3000/api/auth/callback/github
# (Production: https://<your-frontend>.vercel.app/api/auth/callback/github)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (Turso / LibSQL SQLite)
# ------------------------------------------------------------------------------
# Turso Cloud Database:
# Run: turso db show --url <database-name>
# Example: libsql://your-database-name.aws-ap-south-1.turso.io
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso Authentication Token:
# Run: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=your_turso_database_auth_token

# For local development with a local SQLite file (optional):
# TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
# Used for storing hackathon header images, banners, and attachments.
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=hackathon-headers

# ------------------------------------------------------------------------------
# 7. MAILER CONFIGURATION (Nodemailer / Gmail SMTP)
# ------------------------------------------------------------------------------
# Used for team invitation emails and participant notifications.
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 8. LOCALIZATION & SCHEDULING
# ------------------------------------------------------------------------------
# Timezone used for calculating hackathon stage deadlines, check-ins, and schedule windows.
# Default: Asia/Kolkata (IANA timezone format)
APP_TIMEZONE=Asia/Kolkata
