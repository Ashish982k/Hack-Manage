# ==============================================================================
# HACK-MANAGE FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` in the frontend directory:
#   cp .env.example .env
#
# LOCAL DEVELOPMENT:
# The values below default to standard ports (Frontend: 3000, Backend: 5000).
#
# PRODUCTION (Vercel):
# Set these variables in your Vercel Dashboard:
# Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND APPLICATION URL
# ------------------------------------------------------------------------------
# FRONTEND_URL: Used by next.config.ts at build time and server runtime.
# Local: http://localhost:3000
# Production: https://your-project-name.vercel.app
FRONTEND_URL=http://localhost:3000

# NEXT_PUBLIC_FRONTEND_URL: Exposed to the browser for Better Auth client SDK.
# Local: http://localhost:3000
# Production: https://your-project-name.vercel.app
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BACKEND API URL (Hono Server)
# ------------------------------------------------------------------------------
# BACKEND_URL: Server-to-server URL used by Next.js proxy rewrites.
# The browser NEVER talks directly to Render in production; Next.js proxies
# /api/auth/*, /api/hackathons/*, /api/teams/*, /api/users/* to BACKEND_URL.
# This prevents cross-domain cookie and CORS issues.
# Local: http://localhost:5000
# Production: https://your-backend.onrender.com (NO trailing slash)
BACKEND_URL=http://localhost:5000

# NEXT_PUBLIC_BACKEND_URL: Exposed to browser for direct asset or fallback calls.
# Local: http://localhost:5000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
